# Public address players use; needed for secure cookies, OAuth and reset emails.
RIFT_PUBLIC_URL=https://rift.example.com

# Password reset emails (optional; without them reset links go to the log).
# RIFT_SMTP_URL=smtps://user:pass@smtp.example.com
# RIFT_MAIL_FROM=Rift Showdown <noreply@example.com>

# Sign-in providers (optional; each needs both values and RIFT_PUBLIC_URL).
# Redirect URI: <RIFT_PUBLIC_URL>/auth/<google|discord|twitch>/callback
# RIFT_GOOGLE_CLIENT_ID=
# RIFT_GOOGLE_CLIENT_SECRET=
# RIFT_DISCORD_CLIENT_ID=
# RIFT_DISCORD_CLIENT_SECRET=
# RIFT_TWITCH_CLIENT_ID=
# RIFT_TWITCH_CLIENT_SECRET=
